{
  "name": "qpdf-compressor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Minimal local PDF compressor powered by QPDF compiled to WebAssembly.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "wasm:probe": "bun scripts/probe-qpdf-wasm.mjs",
    "test:engine": "bun scripts/test-compression.mjs",
    "test:browser": "bun run build && bun scripts/test-browser.mjs",
    "test:live": "bun scripts/test-live.mjs",
    "screenshots": "bun run build && bun scripts/screenshots.mjs",
    "test": "bun run check && bun run test:engine && bun scripts/test-browser.mjs"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "playwright": "^1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@lucide/svelte": "^1.55.0"
  }
}