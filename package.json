{
  "name": "qpdf-compressor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Minimal local PDF compressor powered by QPDF compiled to WebAssembly.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "wasm:probe": "bun scripts/probe/probe-qpdf-wasm.mjs",
    "fixtures": "bun scripts/generate/make-fixtures.mjs && bun scripts/generate/make-integrity-fixtures.mjs",
    "bench": "bun scripts/tools/bench-pipeline.mjs",
    "bench:legacy": "bun scripts/tools/bench.mjs current",
    "explain": "bun scripts/tools/explain.mjs",
    "profile": "bun scripts/tools/profile.mjs",
    "kernel-bench": "bun scripts/tools/kernel-bench.mjs",
    "heap:images": "node --expose-gc --import ./scripts/tools/register-ts.mjs scripts/tools/heap-images.mjs",
    "verify:live-file": "bun scripts/tools/verify-live-file.mjs",
    "verify:file": "bun scripts/tools/verify-file.mjs",
    "test:engine": "bun scripts/test/test-compression.mjs",
    "test:pipeline": "bun scripts/test/test-pipeline.mjs",
    "test:integrity": "bun scripts/test/test-integrity.mjs",
    "test:structure-control": "bun scripts/test/test-structure-control.mjs",
    "test:fidelity": "bun scripts/test/test-fidelity.mjs",
    "test:fidelity-control": "bun scripts/test/test-fidelity-resize-control.mjs",
    "test:text-extract": "bun scripts/test/test-text-extract.mjs",
    "test:text-integrity": "bun scripts/test/test-text-integrity.mjs",
    "test:cmap": "bun scripts/test/test-cmap.mjs",
    "test:parser-realism": "bun scripts/test/test-parser-realism.mjs",
    "test:resource-limits": "bun scripts/test/test-resource-limits.mjs",
    "test:image-replacements": "bun scripts/test/test-image-replacements.mjs",
    "test:unicode-integrity": "bun scripts/test/test-unicode-integrity.mjs",
    "test:unicode-extraction": "bun scripts/test/test-unicode-extraction.mjs",
    "test:visual-comparator": "bun scripts/test/test-visual-comparator.mjs",
    "test:visual": "bun scripts/test/test-visual.mjs",
    "test:visual:measure": "bun scripts/test/test-visual.mjs --measure",
    "test:browser": "bun run build && bun scripts/test/test-browser.mjs",
    "test:mobile": "bun run build && bun scripts/test/test-mobile.mjs",
    "test:live": "bun scripts/test/test-live.mjs",
    "screenshots": "bun run build && bun scripts/tools/screenshots.mjs",
    "test": "bun run check && bun run test:engine && bun run test:pipeline && bun run test:integrity && bun run test:structure-control && bun run test:fidelity && bun run test:fidelity-control && bun run test:text-extract && bun run test:text-integrity && bun run test:cmap && bun run test:parser-realism && bun run test:resource-limits && bun run test:image-replacements && bun run test:unicode-integrity && bun run test:unicode-extraction && bun run test:visual-comparator && bun run test:visual && bun run test:browser"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "^1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/resize": "^2.1.1",
    "@lucide/svelte": "^1.55.0"
  }
}